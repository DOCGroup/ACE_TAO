// -*- MPC -*-
project(cinset): gperf_test {
  exename = cout

  verbatim(gnuace, bottom) {
    all: runtests

    runtests: cout$(EXEEXT)
    "	@echo "Testing cout"
    "	./cout -v < c.gperf > cout.out
    "	-diff -b c.exp cout.out"

    endif # CROSS-COMPILE
  }

  GPERF_Files {
    commandflags += -p -c -l -S1 -o
    c.gperf
  }

  Source_Files {
    c.cpp
  }
}

project(adainset): gperf_test {
  exename = aout

  verbatim(gnuace, bottom) {
    all: runtests

    runtests: aout$(EXEEXT)
    "	@echo "Testing aout"
    "	./aout -v < ada.gperf > aout.out
    "	-diff -b ada-res.exp aout.out"

    endif # CROSS-COMPILE
  }

  GPERF_Files {
    commandflags += -k1,4,$$
    ada.gperf
  }

  Source_Files {
    ada.cpp
  }
}

