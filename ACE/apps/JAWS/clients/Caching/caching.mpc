// -*- MPC -*-
project(http_client) : aceexe {
  avoids   += ace_for_tao
  requires += ace_filecache

  exename = http_client
  Source_Files {
    http_handler.cpp
    http_client.cpp
  }
}

project(test_URL) : aceexe {
  exename = test_URL
  defines += ACE_SVC_HAS_DLL=0
  Source_Files {
    test_URL.cpp
    Locator_Request_Reply.cpp
    URL_Properties.cpp
    URL_Locator.cpp
  }
}
