cmake_minimum_required(VERSION 3.12.0)

set(ACE_ROOT $ENV{ACE_ROOT})
if(WIN32)
  link_libraries(iphlpapi)
endif()

project(ACE_XML_Utils CXX)
option(BUILD_SHARED_LIBS "Build using shared libraries" ON)


set(HEADER_FILES_ACE_XML_UTILS XMLSchema/Traversal.hpp XMLSchema/TypeInfo.hpp XMLSchema/Types.hpp XMLSchema/Writer.hpp XMLSchema/id_map.hpp XML_Error_Handler.h XML_Helper.h XML_Schema_Resolver.h XML_Utils_Export.h XSCRT/Elements.hpp XSCRT/ExtendedTypeInfo.hpp XSCRT/Parser.hpp XSCRT/Traversal.hpp XSCRT/Writer.hpp XSCRT/XML.hpp XSCRT/XMLSchema.hpp XercesString.h)

set(INLINE_FILES_ACE_XML_UTILS XSCRT/ExtendedTypeInfo.ipp)

set(TEMPLATE_FILES_ACE_XML_UTILS XMLSchema/TypeInfo.tpp XML_Helper.tpp XML_Schema_Resolver.tpp XSCRT/Traversal.tpp)

set(SOURCE_FILES_ACE_XML_UTILS XML_Error_Handler.cpp XML_Schema_Resolver.cpp XercesString.cpp)
if(CMAKE_CONFIGURATION_TYPES)
set(TARGET_LINK_LIBRARIES_ACE_XML_UTILS $<$<CONFIG:Debug>:ACE${LIBRARY_DECORATOR}d>
                          $<$<CONFIG:Release>:ACE${LIBRARY_DECORATOR}> ${XercesC_LIBRARIES})
else()
set(TARGET_LINK_LIBRARIES_ACE_XML_UTILS ACE${LIBRARY_DECORATOR} ${XercesC_LIBRARIES})
endif()
set(PROJECT_TARGET_ACE_XML_UTILS ACE_XML_Utils${LIBRARY_DECORATOR})
if(MSVC)
  add_compile_definitions(_CRT_SECURE_NO_WARNINGS _CRT_SECURE_NO_DEPRECATE _CRT_NONSTDC_NO_DEPRECATE)
endif()
if(MSVC)
  add_compile_options(/wd4355)
endif()
if(MSVC)
  add_compile_definitions(_WINSOCK_DEPRECATED_NO_WARNINGS)
endif()


set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${ACE_ROOT}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG ${ACE_ROOT}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE ${ACE_ROOT}/lib)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${ACE_ROOT}/lib)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${ACE_ROOT}/lib)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_DEBUG ${ACE_ROOT}/lib)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG ${ACE_ROOT}/lib)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE ${ACE_ROOT}/lib)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE ${ACE_ROOT}/lib)

add_library(${PROJECT_TARGET_ACE_XML_UTILS} ${SOURCE_FILES_ACE_XML_UTILS})
if(BUILD_SHARED_LIBS)
  target_compile_definitions(${PROJECT_TARGET_ACE_XML_UTILS} PRIVATE XML_UTILS_BUILD_DLL)
else()
  target_compile_definitions(${PROJECT_TARGET_ACE_XML_UTILS} PRIVATE ACE_AS_STATIC_LIBS)
endif()
target_link_libraries(${PROJECT_TARGET_ACE_XML_UTILS} ${TARGET_LINK_LIBRARIES_ACE_XML_UTILS})
set_target_properties(${PROJECT_TARGET_ACE_XML_UTILS} PROPERTIES DEBUG_POSTFIX "d")
target_compile_features(${PROJECT_TARGET_ACE_XML_UTILS} PUBLIC "cxx_std_17")


if(CMAKE_CONFIGURATION_TYPES)
target_compile_definitions(${PROJECT_TARGET_ACE_XML_UTILS} PUBLIC
                           $<$<CONFIG:Debug>:MPC_LIB_MODIFIER="${LIBRARY_DECORATOR}d">
                           $<$<CONFIG:Release>:MPC_LIB_MODIFIER="${LIBRARY_DECORATOR}">)
endif()

target_include_directories(${PROJECT_TARGET_ACE_XML_UTILS} PRIVATE ${ACE_ROOT} ${XercesC_INCLUDE_DIRS})

target_link_directories(${PROJECT_TARGET_ACE_XML_UTILS} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_BINARY_DIR} ${ACE_ROOT}/lib)

target_compile_definitions(${PROJECT_TARGET_ACE_XML_UTILS} PUBLIC ACE_HAS_IPV6 XML_USE_PTHREADS)


