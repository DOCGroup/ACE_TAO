cmake_minimum_required(VERSION 3.12.0)

set(ACE_ROOT $ENV{ACE_ROOT})
if(WIN32)
  link_libraries(iphlpapi)
endif()
if (WIN32)
  link_libraries(pdh)
endif()

project(Monitor_Control CXX)
option(BUILD_SHARED_LIBS "Build using shared libraries" ON)


set(HEADER_FILES_MONITOR_CONTROL Auto_Update_Starter.h BSD_Network_Interface_Monitor.h Bytes_Received_Monitor.h Bytes_Sent_Monitor.h CPU_Load_Monitor.h Constraint_Interpreter.h Constraint_Visitor.h FreeBSD_Network_Interface_Monitor.h Linux_Network_Interface_Monitor.h Memory_Usage_Monitor.h Monitor_Control.h Monitor_Control_export.h Monitor_Control_utils.h Monitor_Group.h Monitor_Query.h Null_Network_Interface_Monitor.h Num_Threads_Monitor.h Packets_Received_Monitor.h Packets_Sent_Monitor.h Windows_Monitor.h Windows_Multi_Instance_Monitor.h)

set(SOURCE_FILES_MONITOR_CONTROL Auto_Update_Starter.cpp BSD_Network_Interface_Monitor.cpp Bytes_Received_Monitor.cpp Bytes_Sent_Monitor.cpp CPU_Load_Monitor.cpp Constraint_Interpreter.cpp Constraint_Visitor.cpp FreeBSD_Network_Interface_Monitor.cpp Linux_Network_Interface_Monitor.cpp Memory_Usage_Monitor.cpp Monitor_Group.cpp Monitor_Query.cpp Null_Network_Interface_Monitor.cpp Num_Threads_Monitor.cpp Packets_Received_Monitor.cpp Packets_Sent_Monitor.cpp Windows_Monitor.cpp Windows_Multi_Instance_Monitor.cpp)
if(CMAKE_CONFIGURATION_TYPES)
set(TARGET_LINK_LIBRARIES_MONITOR_CONTROL $<$<CONFIG:Debug>:ACE_ETCL_Parser${LIBRARY_DECORATOR}d ACE_ETCL${LIBRARY_DECORATOR}d ACE${LIBRARY_DECORATOR}d>
                          $<$<CONFIG:Release>:ACE_ETCL_Parser${LIBRARY_DECORATOR} ACE_ETCL${LIBRARY_DECORATOR} ACE${LIBRARY_DECORATOR}>)
else()
set(TARGET_LINK_LIBRARIES_MONITOR_CONTROL ACE_ETCL_Parser${LIBRARY_DECORATOR} ACE_ETCL${LIBRARY_DECORATOR} ACE${LIBRARY_DECORATOR})
endif()
set(PROJECT_TARGET_MONITOR_CONTROL ACE_Monitor_Control${LIBRARY_DECORATOR})
if(MSVC)
  add_compile_definitions(_CRT_SECURE_NO_WARNINGS _CRT_SECURE_NO_DEPRECATE _CRT_NONSTDC_NO_DEPRECATE)
endif()
if(MSVC)
  add_compile_options(/wd4355)
endif()
if(MSVC)
  add_compile_definitions(_WINSOCK_DEPRECATED_NO_WARNINGS)
endif()


set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${ACE_ROOT}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG ${ACE_ROOT}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE ${ACE_ROOT}/lib)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${ACE_ROOT}/lib)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${ACE_ROOT}/lib)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_DEBUG ${ACE_ROOT}/lib)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG ${ACE_ROOT}/lib)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE ${ACE_ROOT}/lib)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE ${ACE_ROOT}/lib)

add_library(${PROJECT_TARGET_MONITOR_CONTROL} ${SOURCE_FILES_MONITOR_CONTROL})
if(BUILD_SHARED_LIBS)
  target_compile_definitions(${PROJECT_TARGET_MONITOR_CONTROL} PRIVATE MONITOR_CONTROL_BUILD_DLL)
else()
  target_compile_definitions(${PROJECT_TARGET_MONITOR_CONTROL} PRIVATE ACE_AS_STATIC_LIBS)
endif()
target_link_libraries(${PROJECT_TARGET_MONITOR_CONTROL} ${TARGET_LINK_LIBRARIES_MONITOR_CONTROL})
set_target_properties(${PROJECT_TARGET_MONITOR_CONTROL} PROPERTIES DEBUG_POSTFIX "d")
target_compile_features(${PROJECT_TARGET_MONITOR_CONTROL} PUBLIC "cxx_std_17")


if(CMAKE_CONFIGURATION_TYPES)
target_compile_definitions(${PROJECT_TARGET_MONITOR_CONTROL} PUBLIC
                           $<$<CONFIG:Debug>:MPC_LIB_MODIFIER="${LIBRARY_DECORATOR}d">
                           $<$<CONFIG:Release>:MPC_LIB_MODIFIER="${LIBRARY_DECORATOR}">)
endif()

target_include_directories(${PROJECT_TARGET_MONITOR_CONTROL} PRIVATE ${ACE_ROOT})

target_link_directories(${PROJECT_TARGET_MONITOR_CONTROL} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_BINARY_DIR} ${ACE_ROOT}/lib)

target_compile_definitions(${PROJECT_TARGET_MONITOR_CONTROL} PUBLIC ACE_HAS_IPV6)


