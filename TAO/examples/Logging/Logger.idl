#ifndef TAO_LOGGER_IDL
#define TAO_LOGGER_IDL

// TAO_MAXLOGMSGLEN must be the same size as ACE_MAXLOGMSGLEN.
#if !defined TAO_MAXLOGMSGLEN
#define TAO_MAXLOGMSGLEN 4 * 1024
#endif /* TAO_MAXLOGMSGLEN */

typedef string<TAO_MAXLOGMSGLEN> TAO_log_string;
interface Logger
{
  /// Logs messages to a server through a CORBA wrapper around
  /// ACE_Log_Msg.

  enum Log_Priority
  {
    /// Shutdown the logger.
    LM_SHUTDOWN,

    /// Messages indicating function-calling sequence.
    LM_TRACE,

    /// Messages containing information normally useful only for debugging.
    LM_DEBUG,

    /// Informational messages.
    LM_INFO,

    /// Conditions that are not errors but may require special handling.
    LM_NOTICE,

    /// Warning messages.
    LM_WARNING,

    /// Initialize the logger.
    LM_STARTUP,

    /// Error messages.
    LM_ERROR,

    /// Critical conditions, such as hard device errors.
    LM_CRITICAL,

    /// A condition that should be corrected immediately, such as a
    /// corrupted system database.
    LM_ALERT,

    /// A panic condition, normally broadcast to all users.
    LM_EMERGENCY,

    /// In ACE_Log_Priority, LM_MAX aliases LM_EMERGENCY rather than being
    /// a distinct tag, which is invalid IDL syntax; TAO adjusts for this.
    LM_MAX
  };

  enum Verbosity_Level
  {
    /// Display messages in a verbose manner.
    VERBOSE,

    /// Display messages only when they can change between calls.
    VERBOSE_LITE,

    /// Do not display messages; retain them in thread-specific storage.
    SILENT
  };

  struct Log_Record
  {
    /// Type of logging message.
    Log_Priority type;
    /// Timestamp of the sender.
    long time;
    /// Process ID of the sender.
    long app_id;
    /// IP address of the sender.
    long host_addr;
    /// Logging message.
    TAO_log_string msg_data;
  };

  /// Transmits a Log_Record to the logging server.
  oneway void log (in Log_Record log_rec);

  /// Logs a message with a verbosity level that may differ from the
  /// configured verbosity level.
  oneway void logv (in Log_Record log_rec,
                    in Verbosity_Level level);

  /// Like log(), but waits until the logger receives the message.
  void log_twoway (in Log_Record log_rec);

  /// Like logv(), but waits until the logger receives the message.
  void logv_twoway (in Log_Record log_rec,
                    in Verbosity_Level level);

  /// Changes the verbosity level, controlling how much information the
  /// server displays.
  oneway void verbosity (in Verbosity_Level level);
};

interface Logger_Factory
{
  /// Creates a Logger of the specified name.

  /// Returns a new Logger if name is unique, or the existing Logger
  /// with that name.
  Logger make_logger (in string name);
};

#endif /* TAO_LOGGER_IDL */
