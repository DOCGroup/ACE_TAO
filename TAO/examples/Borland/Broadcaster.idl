/* -*- C++ -*- */
#include "Receiver.idl"

/// This interface is implemented by the simple chat server. It broadcasts
/// messages received from one registered client to all registered clients.
interface Broadcaster
{
  exception CannotAdd
    {
      string reason_;
    };

  exception CannotRemove
    {
      string reason_;
    };

  /// Registers a Receiver with the chat server. A registered client
  /// must call un_register before it goes away.
  void add (in Receiver r_, in string nickname)
    raises (CannotAdd);

  /// Unregisters a Receiver.
  void remove (in Receiver r)
    raises (CannotRemove);

  /// Says something to all registered clients.
  void say (in Receiver r, in string text);
};
