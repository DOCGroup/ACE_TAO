/* -*- C++ -*- */
#include "Receiver.idl"

interface Broadcaster
{
  /// Implemented by the simple chat server to broadcast messages from one
  /// registered client to all registered clients.

  exception CannotAdd
    {
      string reason_;
    };

  exception CannotRemove
    {
      string reason_;
    };

  /// Registers a Receiver with the chat server. A registered client must
  /// call un_register before it goes away.
  void add (in Receiver receiver_, in string nickname)
    raises (CannotAdd);

  /// Unregisters a Receiver.
  void remove (in Receiver receiver_)
    raises (CannotRemove);

  /// Sends a message to all registered clients.
  void say (in Receiver receiver_, in string text);
};
