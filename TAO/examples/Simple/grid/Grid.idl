// -*- C++ -*-
interface Grid
{
  /// Creates a Grid of the specified type.

  /// Height of the grid.
  attribute short height;

  /// Width of the grid.
  attribute short width;

  exception RANGE_ERROR
    {
      /// The range of parameter values does not fall in the expected range.
    };

  /// @name Constants for locations and values
  /// @{
  const short DEFAULT_LOCATION = 1;
  const short DEFAULT_VALUE = 100;
  /// @}

  /// Sets the element [n,m] of the grid to value.
  void set (in short n, in short m, in long value)
    raises (RANGE_ERROR);

  /// Returns the element [n,m] of the grid.
  long get (in short n, in short m)
    raises (RANGE_ERROR);

  /// Destroys the grid.
  void destroy ();
};

interface Grid_Factory
{
  /// Factory that creates a Grid.

  /// @name Default Grid dimensions
  /// @{
  const short DEFAULT_HEIGHT = 10;
  const short DEFAULT_WIDTH = 10;
  /// @}

  /// Returns a new Grid instance.
  Grid make_grid (in short height, in short width);

  /// Shuts down the application.
  oneway void shutdown ();
};
