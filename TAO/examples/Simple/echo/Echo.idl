/* -*- C++ -*- */
#if !defined (_ECHO_IDL)
#define _ECHO_IDL

interface Echo
{
  /// Encapsulates operations that return and display messages and shut
  /// down the server.

  typedef sequence<Object> List;

  /// Returns the message as a sequence of Objects and displays it as a string.
  List echo_list (in string message);

  /// Returns the message as a string and displays it on the screen.
  string echo_string (in string message);

  /// Shuts down the server.
  oneway void shutdown ();
};

#endif /* _ECHO_IDL */
