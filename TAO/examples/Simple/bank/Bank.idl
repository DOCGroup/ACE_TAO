// -*- C++ -*-
/// This module defines the Account interface and a factory for Account objects.
module Bank
{
  interface Account
    {
      /// Represents an account with operations to check its balance,
      /// deposit money, and withdraw money.

      exception Overdraft
        {
          /// Raised when a client tries to withdraw more than the balance.

          string reason;
        };

      /// Obtains the current balance.
      readonly attribute float balance;

      /// Adds the amount to this account.
      void deposit (in float amount);

      /// Withdraws the amount from this account.
      void withdraw (in float amount) raises (Overdraft);

      /// The name of this account.
      attribute string name;
    };

  interface AccountManager
    {
      /// Creates and closes Account objects.

      /// Returns the Account associated with name. If name has not been
      /// seen before, the server creates an account; otherwise, it returns
      /// the existing object reference.
      Account open (in string name,
                    in float initial_balance);

      /// Closes the account and releases its resources if this is its last
      /// reference. The account cannot be accessed after this call.
      void close (in Account account_);

      /// Shuts down the server.
      void shutdown ();
    };
};
