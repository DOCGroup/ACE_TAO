
interface Peer;
typedef sequence<Peer> PeerSet;

/// A simple interface to demonstrate AMI. A set of peers connect to the
/// progress server. Once all peers have connected, each sends multiple
/// requests to every other peer using AMI. The progress server displays
/// the reported progress.
interface Peer
{
  /// Sends back the number in <id>.
  long request (in long id);
  /// Starts the demo in one peer.
  oneway void start (in PeerSet the_peers,
                     in long iterations);
  /// Shuts down the ORB.
  oneway void shutdown ();
};

/// Reports progress for multiple applications running in parallel.
/// Each application is identified by an <id> and reports as asynchronous
/// requests are sent and received.
interface Progress
{
  oneway void sent_request (in long id);
  oneway void recv_reply (in long id);

  /// Binds one of the peers.
  long bind (in Peer a_peer);
};
