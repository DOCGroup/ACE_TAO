/**
 * @file Load_Balancer.idl
 * @brief Interfaces for a CORBA load-balancing service that can be used with
 * the Naming Service or on its own.
 *
 * See the README for other approaches to distributed load balancing and
 * their use cases.
 *
 * @author The interfaces are based on OrbixNames load-balancing features,
 * with modifications by Doug Schmidt <d.schmidt@vanderbilt.edu> and Marina
 * Spivak <marina@cs.wustl.edu>.
 */

/**
 * @brief Treats groups of objects as equivalence classes for distributed
 * load balancing.
 *
 * Object_Group_Factory creates groups. A round-robin group resolves requests
 * to arbitrary members in turn; a random group selects arbitrary members at
 * random. Both types share the Object_Group interface and differ in their
 * implementations.
 */
module Load_Balancer
{
  exception no_such_member {};
  exception duplicate_member {};
  exception duplicate_group {};
  exception no_such_group {};

  typedef string Member_ID;
  typedef sequence<Member_ID> Member_ID_List;

  struct Member
  {
    /// IOR of an Object_Group member.
    Object obj;

    /// Unique identifier for this Object_Group member.
    Member_ID id;
  };

  typedef string Group_ID;
  typedef sequence<Group_ID> Group_List;

  interface Object_Group;

  /// Creates and tracks round-robin and random Object_Group instances.
  interface Object_Group_Factory
  {
    /// Creates a round-robin group. Throws duplicate_group if a live group
    /// with this ID already exists.
    Object_Group make_round_robin (in Group_ID id)
      raises (duplicate_group);

    /// Creates a random group. Throws duplicate_group if a live group with
    /// this ID already exists.
    Object_Group make_random (in Group_ID id)
      raises (duplicate_group);

    /// Finds and returns the group with this ID, or throws no_such_group.
    Object_Group resolve (in Group_ID id) raises (no_such_group);

    /// Lists the IDs of all live round-robin groups created by this factory.
    Group_List round_robin_groups ();

    /// Lists the IDs of all live random groups created by this factory.
    Group_List random_groups ();
  };

  /**
   * @brief Holds object references and selects members according to a load-
   * balancing policy.
   *
   * A client asks an Object_Group for an object with the required type or
   * functionality. The group selects a member according to its policy and
   * returns that member to the client.
   */
  interface Object_Group
  {
    /// Unique identifier for this group.
    readonly attribute string id;

    /// Adds a member. Member IDs must be unique within the group; otherwise
    /// duplicate_member is raised.
    void bind (in Member member_) raises (duplicate_member);

    /// Removes the member with this ID, or throws no_such_member.
    void unbind (in Member_ID id) raises (no_such_member);

    /// Returns a member according to the group's policy, or throws
    /// no_such_member if the group is empty.
    Object resolve () raises (no_such_member);

    /// Returns the member with this ID, or throws no_such_member.
    Object resolve_with_id (in Member_ID id) raises (no_such_member);

    /// Lists the IDs of all members in the group.
    Member_ID_List members ();

    /// Releases the group's resources. Later calls on this group should fail,
    /// its ID becomes available, and its factory no longer lists it.
    void destroy ();
  };
};
