/// IDL schema definition for Web server interface.
module Web_Server
{
  typedef sequence<octet> Chunk_Type;

  interface Callback
    {
      /// Called back by the server to pass the next <chunk> of the file.
      /// If there are no more chunks, <last_chunk> is true.
      void next_chunk (in Chunk_Type chunk,
                       in boolean last_chunk);
    };

  exception Error_Result
    {
      /// Status of the <register_callback> operation. These values should map
      /// to normal HTTP status values, e.g., 200 means success and 404 means
      /// "file not found."
      short status;
    };

  struct Metadata_Type
  {
    /// Modification date.
    string modification_date;

    /// Type of content.
    string content_type;
  };

  interface Iterator_Factory
    {
      /// Registers a <Callback> that the Web server uses to push data
      /// associated with <pathname> one chunk at a time. <metadata> reports
      /// information about <pathname>.
      Metadata_Type register_callback (in string pathname,
                                       in Callback client_callback)
        raises (Error_Result);
    };
};
