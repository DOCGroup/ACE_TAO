/// IDL schema definition for Web server interface.
module Web_Server
{
  typedef sequence<octet> Chunk_Type;

  interface Content_Iterator
  {
    /// Returns the next @a chunk of the file starting at @a offset. If there
    /// are no more bindings, false is returned.
    boolean next_chunk (in unsigned long long offset,
                        out Chunk_Type chunk);

    /// Destroys the iterator.
    void destroy ();
  };

  exception Error_Result {
    /// Status of the @c get_iterator operation. These values should map to
    /// normal HTTP status values, e.g., 200 means success and 404 means
    /// "file not found."
    short status;
 };

  struct Metadata_Type
  {
    /// Modification date.
    string modification_date;

    /// Type of content.
    string content_type;
  };

  interface Iterator_Factory
  {
    /// Returns a @c Content_Iterator for reading the @a contents associated
    /// with @a pathname one chunk at a time. @a metadata describes the
    /// @a contents.
    void get_iterator (in string pathname,
                       out Content_Iterator contents,
                       out Metadata_Type metadata)
      raises (Error_Result);
  };
};
