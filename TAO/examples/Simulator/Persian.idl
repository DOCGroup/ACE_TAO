/**
 * @file Persian.idl
 * @brief Data struct and termination interface for the DOVE Persian
 *        Recursion Demo.
 * @author Chris Gill <cdgill@cs.wustl.edu>
 */

#ifndef TAO_PERSIAN_RECURSION_IDL
#define TAO_PERSIAN_RECURSION_IDL

#include "TimeBase.idl"
#include "RtecScheduler.idl"
#pragma prefix ""

module PersianRecursion
{
  /// Defines the criticality of the operation for use with Dynamic Scheduler.
  enum Line_Color_t
  {
    BLACK,
    BLUE,
    YELLOW,
    RED,
    GREEN,
    WHITE
  };

  struct Data
  {
    /// @name Demuxing part
    /// @{
    RtecScheduler::Criticality_t criticality_level;
    /// @}
    /// @name Data part
    /// @{
    Line_Color_t line_color;
    short x1;
    short y1;
    short x2;
    short y2;
    /// @}
    /// @name Metrics part
    /// @{
    TimeBase::TimeT computation_time;
    /// @}
  };

  /// This interface provides an operation for cleanly shutting down the ORB
  /// from a synchronously dispatched servant when a request originates in
  /// another thread.
  interface Terminator
  {
    void shutdown ();
  };
};

#endif /* TAO_PERSIAN_RECURSION_IDL */
