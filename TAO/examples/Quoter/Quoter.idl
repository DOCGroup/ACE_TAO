/**
 * @file Quoter.idl
 * @brief Quoter example showing the global POA and CosLifeCycle service.
 * @author Darrell Brunsch <brunsch@cs.wustl.edu> and Michael Kircher
 * <mk1@cs.wustl.edu>
 */

#include "orbsvcs/CosLifeCycle.idl"

module Stock
{
  exception Invalid_Stock {};
  exception Invalid_Quoter {};

  /// Provides stock information.
  interface Quoter : CosLifeCycle::LifeCycleObject
  {
    /// Returns the current stock value or raises an exception.
    long get_quote (in string stock_name)
      raises (Invalid_Stock, Invalid_Quoter);
  };

  /// Creates Quoter objects.
  interface Quoter_Factory
  {
    /// Returns a new Quoter selected by name, such as "Dow Jones" or
    /// "Reuters".
    Quoter create_quoter (in string name)
      raises (Invalid_Quoter);
  };

  /// Wraps the CosLifeCycle FactoryFinder.
  interface Quoter_Factory_Finder : CosLifeCycle::FactoryFinder
  {
  };

  /// Wraps the CosLifeCycle GenericFactory.
  interface Quoter_Generic_Factory : CosLifeCycle::GenericFactory
  {
  };

  /// Adds a factory-registration operation to the CosLifeCycle GenericFactory.
  interface Quoter_Life_Cycle_Service : CosLifeCycle::GenericFactory
  {
    /// Registers a factory with its name, location, description, and object.
    void register_factory (in string name,
                           in string location,
                           in string description,
                           in Object _object);
  };

  /**
   * @brief Evaluates CosLifeCycle criteria through a simpler interface.
   */
  interface Criteria_Evaluator
  {
    typedef sequence <CosLifeCycle::NameValuePair> SeqNamedValuePair;
    typedef CosLifeCycle::Criteria Criteria;

    /// Raised when the requested configuration is unavailable.
    exception NotAvailable { string reason; };

    /// Returns the initialization properties.
    SeqNamedValuePair getInitialization ();

    /// Returns the filter string.
    string getFilter ();

    /// Returns the logical location.
    SeqNamedValuePair getLogicalLocation ();

    /// Returns the preferences string; currently not implemented.
    string getPreferences ();

    /// Sets the criteria used to search for keywords.
    void setCriteria (in Criteria criteria_);
  };
};
