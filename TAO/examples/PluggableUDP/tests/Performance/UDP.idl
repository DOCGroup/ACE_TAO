/* -*- C++ -*- */
/// Defines an interface that encapsulates operations that return the current
/// time of day and shut down the server.
interface UDP
{
  struct LongStruct
  {
    long x;
    string str;
  };

  typedef sequence<LongStruct> LongSeq;

  oneway void setResponseHandler (in UDP udpHandler);

  oneway void reset (in string client_name);

  oneway void invoke (in string client_name,
                      in long request_id);

  /// Shuts down the application.
  oneway void shutdown ();
};
