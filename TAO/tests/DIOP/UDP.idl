/* -*- C++ -*- */
// UDP.idl
interface UDP
{
  /// Defines operations to request the current time from another
  /// machine and shut down the server.

  /// Returns the current time of day to a client on another machine.
  oneway void invoke (in string client_name,
                      in UDP udpHandler,
                      in long request_id);

  /// Shuts down the application.
  oneway void shutdown ();
};
