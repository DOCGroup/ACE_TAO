/**
 * @file Supports_Test.idl
 * @author George Edwards <g.edwards@vanderbilt.edu>
 * @brief Defines valuetypes and interfaces for testing TAO's OBV support.
 *
 * The test checks valuetypes that support concrete interfaces by using one
 * implementation for both valuetypes and object references, passing them as
 * parameters, and invoking local and remote calls. It also checks the return
 * values of ORB::register_value_factory().
 */

module Supports_Test
{

  valuetype Node;

  typedef sequence<Node> Node_List;

  /**
   * @brief Basic building block of the vt_graph valuetype defined below.
   *
   * Some operations and state members are not currently used in the test.
   */
  valuetype Node
  {

    void print ();

    public string name_;
    private long weight_;
    private short degree_;
    private Node_List neighbors_;

    void change_weight (in long new_weight);
    void add_edge (in Node neighbor);
    void remove_edge (in Node neighbor);

    factory create ();

  };

  /**
   * @brief Operations invoked on vt_graph valuetypes and graph object refs.
   *
   * The implementations are defined in vt_graph. All graph object refs are
   * vt_graph instances under the hood.
   */
  interface graph
  {

    long size ();
    void add_node (in string name);
    void print ();

  };

  valuetype vt_graph supports graph
  {

    private Node_List nodes_;
    factory create ();

  };

  /// Operations used to run the test.
  interface test
  {

    void pass_vt_graph_in (in vt_graph vt_graph_param);
    void pass_obj_graph_in (in graph graph_param);
    void pass_vt_graph_out (out vt_graph vt_graph_param);
    void pass_obj_graph_out (out graph graph_param);
    void pass_vt_graph_inout (inout vt_graph vt_graph_param);
    void pass_obj_graph_inout (inout graph graph_param);
    void start ();
    oneway void finish ();

  };

};
