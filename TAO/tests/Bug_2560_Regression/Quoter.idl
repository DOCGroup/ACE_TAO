
module Quoter
{
  /// Raised when a stock symbol is unknown.
  exception Invalid_Stock_Symbol {};

  interface Stock;

  /// A factory for stock-quoter interfaces.
  interface Stock_Factory
  {
    /// Returns the stock interface identified by its symbol.
    Stock get_stock (in string stock_symbol)
      raises (Invalid_Stock_Symbol);
  };

  /// Queries a stock's symbol, name, price, and price history.
  interface Stock
  {
    typedef sequence<double> StockHistory;

    /// Returns the stock symbol.
    readonly attribute string symbol;

    /// Returns the full stock name.
    readonly attribute string full_name;

    /// Returns the current stock price.
    double price ();

    StockHistory history ();
  };
};
