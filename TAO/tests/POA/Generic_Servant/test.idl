interface test
{
  /// A twoway operation.
  void method ();

  /// A oneway operation.
  oneway void oneway_method ();

  /// A timed twoway operation.
  void timed_method (in unsigned long timeout);

  /// A timed oneway operation.
  oneway void timed_oneway_method (in unsigned long timeout);

  /// Shutdown the server.
  void shutdown ();
};
