
interface Callback
{
  /// Shuts down the client cleanly or simulates a catastrophic failure.
  oneway void shutdown (in boolean is_clean);
};

interface Simple_Server
{
  /// Calls the server and optionally uses a callback to test client shutdowns.
  long test_method (in boolean do_callback,
                    in boolean is_clean,
                    in Callback cb);

  /// Shuts down the server, optionally simulating an abort.
  void shutdown_now (in boolean is_clean);

  /// Shuts down the server without returning a communication failure.
  oneway void shutdown ();
};
