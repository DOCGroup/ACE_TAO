valuetype Accessor_Optimized_Leaf
{
  public long leaf_value;
};

valuetype Accessor_Optimized_Value
{
  public long value;
  public Accessor_Optimized_Leaf child;
};

valuetype Accessor_Optimized_Derived : Accessor_Optimized_Value
{
  public long derived_value;
};

interface Accessor_Optimized_Interface
{
};

/// The derived valuetype inherits refcount overrides for a supported interface.
valuetype Accessor_Optimized_Refcount_Base
  supports Accessor_Optimized_Interface
{
  public long base_value;
};

valuetype Accessor_Optimized_Refcount_Derived : Accessor_Optimized_Refcount_Base
{
  public long derived_value;
};
