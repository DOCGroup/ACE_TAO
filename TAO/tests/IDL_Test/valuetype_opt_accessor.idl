valuetype Accessor_Optimized_Leaf
{
  public long leaf_value;
};

valuetype Accessor_Optimized_Value
{
  public long value;
  public Accessor_Optimized_Leaf child;
};

valuetype Accessor_Optimized_Derived : Accessor_Optimized_Value
{
  public long derived_value;
};

/// An operation-bearing optimized derived value must not inherit a sliced copy.
valuetype Accessor_Optimized_Operation_Derived : Accessor_Optimized_Value
{
  void op ();
};

interface Accessor_Optimized_Interface
{
};

interface Accessor_Optimized_Second_Interface
  : Accessor_Optimized_Interface
{
};

/// The derived valuetype inherits refcount overrides for a supported interface.
valuetype Accessor_Optimized_Refcount_Base
  supports Accessor_Optimized_Interface
{
  public long base_value;
};

valuetype Accessor_Optimized_Refcount_Derived : Accessor_Optimized_Refcount_Base
{
  public long derived_value;
};

/// A derived valuetype inherits one counter and supports another interface.
valuetype Accessor_Optimized_Refcount_Multi_Derived
  : Accessor_Optimized_Refcount_Base
  supports Accessor_Optimized_Second_Interface
{
  public long multi_derived_value;
};

/// The derived valuetype inherits a counter and adds another supported interface.
valuetype Accessor_Optimized_Refcount_Parent
{
  public long parent_value;
};

valuetype Accessor_Optimized_Refcount_Inherited : Accessor_Optimized_Refcount_Parent
  supports Accessor_Optimized_Interface
{
  public long inherited_value;
};

valuetype Accessor_Optimized_Base
{
  public long value;
  factory create ();
};

valuetype Accessor_Optimized_Factory_Derived : Accessor_Optimized_Base
{
  void op ();
};
