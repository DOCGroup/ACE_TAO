/// @file test.idl
/// @brief IDL definitions for the nested-upcall regression test.
/// @author Irfan Pyarali

interface client
{
  /// Decrements c time_to_live and pings the server until it reaches zero.
  void ping (in unsigned short time_to_live);
};

interface server
{
  /// Turns around and starts pinging the client.
  void start (in client c,
              in unsigned short time_to_live);

  /// Decrements c time_to_live and pings the client until it reaches zero.
  void ping (in unsigned short time_to_live);

  /// Shuts down the server.
  oneway void shutdown ();
};
