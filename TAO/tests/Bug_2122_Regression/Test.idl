/**
 * @file Test.idl
 */

module Test
{
   typedef string<10> MyStringType;
   /// Note: SAME LENGTH
   typedef string<10> MyOtherStringType;

   interface Foo
   {
      void op1( in MyStringType s);
      void op2( in MyOtherStringType s);
   };
};

module Foo
{
   module One
   {
      typedef string<40> MyString;

      interface Whatever
      {
         void someOp( in MyString s);
      };
   };

   module Two
   {
      /// Same name, different size!
      typedef string<100> MyString;

      interface WhoCares
      {
         void someOp( in MyString s);
      };
   };

   module Three
   {
      /// Same name, same size!
      typedef string<100> MyString;

      interface WhoCares
      {
         void someOp( in MyString s);
      };
   };
};
