
//=============================================================================
/**
 *  @file    test.idl
 *
 * Simple IDL file to test portable interceptor support.
 *
 *
 *  @author Nanbor Wang <nanbor@cs.wustl.edu>
 */
//=============================================================================


module Test_Interceptors
{
  exception Silly
    {};

  /// Tests portable interceptor behavior visually.
  interface Visual
  {
    /// Normal operation.
    void normal (in long arg);

    /// Normal operation without a return value.
    void nothing ();

    /// Raises a user exception.
    void user ()
      raises (Silly);

    /// Raises a system exception.
    void system ();

    /// Shuts down the ORB.
    oneway void shutdown ();
  };
};
