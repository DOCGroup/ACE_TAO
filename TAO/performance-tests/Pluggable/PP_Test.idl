/* -*- C++ -*- */
/// Defines operations used to test TAO Pluggable Protocols. The operations
/// send octets, voids, and octet sequences.
interface Pluggable_Test
{
  /// Tests the basic latency of a nil oneway operation.
  oneway void send_oneway ();
  /// Tests the basic latency of a nil operation.
  void send_void ();
  /// Shuts down the application.
  oneway void shutdown ();
};

/// Creates <Pluggable_Test> objects.
interface Pluggable_Test_Factory
{
  Pluggable_Test make_pluggable_test ();
};
