interface Cubit
{
  /// Defines an interface that encapsulates operations that cube numbers.
  ///
  /// This interface encapsulates operations that cube octets, shorts,
  /// longs, structs, and unions.

  struct Many
  {
    /// Octet member, normally followed by three bytes of padding.
    octet o;
    long l;
    /// Short member, normally followed by two bytes of padding.
    short s;
  };

  /// Cube an octet.
  octet cube_octet (in octet o);

  /// Cube a short.
  short cube_short (in short s);

  /// Cube a long.
  long cube_long (in long l);

  /// Cube each of the members of a struct.
  Many cube_struct (in Many values);

  /// Null operation.
  oneway void noop ();

  /// Shut down the application.
  oneway void shutdown ();

};

