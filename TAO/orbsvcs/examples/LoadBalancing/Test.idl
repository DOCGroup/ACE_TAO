
module Test
{
  /// Reports an invalid stock name.
  exception Invalid_Stock_Symbol {};

  /// Forward declaration of the Stock interface.
  interface Stock;

  /// Factory for stock interfaces, returning them by stock name.
  interface StockFactory
  {
    Stock get_stock (in string stock_symbol)
      raises (Invalid_Stock_Symbol);

    oneway void shutdown ();
  };

  /// Simple interface for querying the name and price of a stock.
  interface Stock
  {
    /// Returns the stock symbol.
    readonly attribute string symbol;

    /// Returns the stock name.
    readonly attribute string full_name;

    /// Returns the stock price.
    double price ();
  };
};
