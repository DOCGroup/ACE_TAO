module TimeModule {

  struct TimeOfDay {
    /// 0 - 23
    short hour;
    /// 0 - 59
    short minute;
    /// 0 - 59
    short second;
  };

  interface Time {
    TimeOfDay   get_gmt();

    /// Make this a oneway call to allow
    /// the server to shut down immediately.
    oneway void Shutdown();
  };

};
