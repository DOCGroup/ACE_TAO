project(*application): messaging, rteventexe, rtevent_serv, naming {
  after  += ECMcastTests_lib
  libs     += ECMcastTests
  libpaths += ../Common
  includes += ../Common

  exename   = application

  Source_Files {
    application.cpp
  }
}

project(*payload_test): rteventexe {
  exename = heartbeat_payload_test

  Source_Files {
    heartbeat_payload_test.cpp
  }
}

project(*gateway-ec): messaging, rteventexe, rtevent_serv, naming {
  after  += ECMcastTests_lib
  libs     += ECMcastTests
  libpaths += ../Common
  includes += ../Common

  exename   = gateway-ec

  Source_Files {
    gateway-ec.cpp
  }
}
