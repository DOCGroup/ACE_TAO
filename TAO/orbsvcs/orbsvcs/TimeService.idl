/// -*- C++ -*-
#ifndef TAO_TIME_IDL
#define TAO_TIME_IDL

#include "tao/TimeBase.pidl"

#pragma prefix "omg.org"

/// @brief CosTime Module
///
/// This module has all the interfaces, and associated enum and exception
/// declarations for the time service.
module CosTime
{
  /// TimeComparison defines the possible values that can be returned as a
  /// result of comparing two UTOs.
  enum TimeComparison
  {
    TCEqualTo,
    TCLessThan,
    TCGreaterThan,
    TCIndeterminate
  };

  /// ComparisonType defines the possible ways in which the times can be
  /// compared.
  enum ComparisonType
  {
    IntervalC,
    MidC
  };

  /// OverlapType specifies the type of overlap between two time intervals.
  enum OverlapType
  {
    OTContainer,
    OTContained,
    OTOverlap,
    OTNoOverlap
  };

  /// TimeUnavailable exception is raised by the Timeservice when it cannot
  /// successfully return time.
  exception TimeUnavailable
    {
    };

  /// Forward declaration.
  interface TIO;

  /// @brief The interface UTO is an encapsulation of time.
  ///
  /// This interface provides the following operations on basic time:
  /// - Construction of a UTO from piece parts, and extraction of the piece
  ///   parts from a UTO. The piece parts are the readonly attributes:
  ///   time, inaccuracy, time displacement factor, and structure with all the
  ///   above.
  /// - Comparison of time.
  /// - Conversion from relative to absolute time, and conversion to an
  ///   interval (TIO).
  interface UTO
    {
      /// Absolute time value.
      readonly attribute TimeBase::TimeT time;

      /// inaccuracy in the time.
      readonly attribute TimeBase::InaccuracyT inaccuracy;

      /// the time displacement factor.
      readonly attribute TimeBase::TdfT tdf;

      /// structure having the absolute time, the inaccuracy and the time
      /// displacement factor.
      readonly attribute TimeBase::UtcT utc_time;

      /// This returns the absolute time by adding the base time to the
      /// relative time in the object.
      UTO absolute_time ();

      /// Compares the time contained in the object with the time in the
      /// supplied UTO according to the supplied comparison type.
      TimeComparison compare_time (in ComparisonType comparison_type,
                                   in UTO otu);

      /// Returns a TIO representing the time interval between the time in the
      /// object and the time in the UTO passed as a parameter. The interval
      /// returned is the interval between the mid-points of the two UTOs.
      /// Inaccuracies are ignored. Note the result of this operation is
      /// meaningless if the base times of UTOs are different.
      TIO time_to_interval (in UTO otu);

      /// Returns a TIO object representing the error interval around the
      /// time value in the UTO.
      TIO interval ();
    };

  /// @brief The TIO represents a time interval.
  ///
  /// This interface has operations to compare itself with a UTO or another
  /// TIO. It also has an operation to create a UTO from the value of its time
  /// interval.
  interface TIO
    {
      /// Consists of a lower and an upper bound for the time interval.
      readonly attribute TimeBase::IntervalT time_interval;

      /// This operation compares the time in this interface with the time in
      /// the supplied UTO and returns the overlap type as well as the interval
      /// of overlap in the form of a TIO.
      CosTime::OverlapType spans (in UTO time,
                                  out TIO overlap);

      /// This operation compares the time in this interface with the time in
      /// the supplied TIO and returns the overlap type as well as the interval
      /// of overlap in the form of a TIO.
      CosTime::OverlapType overlaps (in TIO interval,
                                     out TIO overlap);

      /// Converts the time interval in this interface into a UTO object by
      /// taking the midpoint of the interval as the time and the interval as
      /// the error envelope around the time.
      UTO time ();
    };

  /// The time service manages the UTOs and the TIOs. This is the first
  /// interface seen by the clients requesting time.
  interface TimeService
    {
      /// This operation returns the current time and an estimate of
      /// inaccuracy in a UTO.
      UTO universal_time () raises (TimeUnavailable);

      /// This operation returns the current time in a UTO only if the time
      /// can be guaranteed to have been obtained securely.
      UTO secure_universal_time () raises(TimeUnavailable);

      /// This creates a new UTO based on the given parameters.
      UTO new_universal_time (in TimeBase::TimeT time,
                              in TimeBase::InaccuracyT inaccuracy,
                              in TimeBase::TdfT tdf);

      /// This creates a new UTO given a time in the UtcT form.
      UTO uto_from_utc (in TimeBase::UtcT utc);

      /// This creates a new TIO with the given parameters.
      TIO new_interval (in TimeBase::TimeT lower,
                        in TimeBase::TimeT upper );
    };
};

#endif /* TAO_TIME_IDL */
